{
  api_key: "API_KEY_PLACEHOLDER",
"scalyr_server": "https://xdr.eu1.sentinelone.net",
  server_attributes: {
  }

logs: [
    { path: "C:\\Windows\\System32\\LogFiles\\DNS\\dns.log", attributes: {parser: "DNSLog"} }
]


monitors: [
  {
    module: "scalyr_agent.builtin_monitors.windows_event_log_monitor",
    channels: [
        { "channel": [ "Application", "Security", "System" ],
          "query": "*[System/Level=0 or System/Level=1 or System/Level=2 or System/Level=3 or System/Level=4]"
        }
    ]
  },
  {
          module: "scalyr_agent.builtin_monitors.shell_monitor",
          id: "cmd",
          command: "powershell -command \"" + 
                   "Get-Process" 
                                         + "\""
          log_all_lines: "True"
          max_characters: "10000"
          sample_interval: 60
     }
]
}


